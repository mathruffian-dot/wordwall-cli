      "title": "直接解聯立方程式",
      "prompt": "解下列二元一次聯立方程式，x 值為何？",
      "options": [
        "−4",
        "−2",
        "2",
        "4"
      ],
      "correct": 2,
      "correct_label": "C",
      "explanation": "兩式相加得 3x=6，所以 x=2。",
