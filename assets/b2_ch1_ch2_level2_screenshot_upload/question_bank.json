      "image": "q02.png",
      "level": 2
    },
    {
      "id": "q03",
      "title": "消去法與代數式",
      "prompt": "若聯立方程式的解為 x=a、y=b，則 a+2b 為何？",
      "options": [
        "33",
        "9",
        "−3",
        "−27"
      ],
      "correct": 1,
      "correct_label": "B",
      "explanation": "兩式相加得 60x=120，所以 x=2；代回得 y=7/2，a+2b=2+7=9。",
      "source": "114 年第 4 題",
      "image": "q03.png",
      "level": 2
    },
    {
      "id": "q04",
      "title": "改編題：加減消去",
      "prompt": "解下列聯立方程式，x+y 為何？",
      "options": [
        "3",
        "4",
        "5",
        "6"
      ],
      "correct": 2,
      "correct_label": "C",
      "explanation": "兩式相加得 4x=12，所以 x=3、y=2，x+y=5。",
      "source": "115 年第 1 題改編",
      "image": "q04.png",
      "level": 2
    },
    {
      "id": "q05",
      "title": "改編題：兩式相減",
      "prompt": "解下列聯立方程式，x−y 為何？",
