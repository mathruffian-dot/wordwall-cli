      "level": 2
    },
    {
      "id": "q02",
      "title": "代入法與代數和",
      "prompt": "若聯立方程式的解為 x=a、y=b，則 a+b 為何？",
      "options": [
        "−28",
        "−14",
        "−4",
        "14"
      ],
      "correct": 2,
      "correct_label": "C",
      "explanation": "代入 y=−3x 得 14x=28，x=2、y=−6，所以 a+b=−4。",
